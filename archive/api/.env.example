# DFIR Platform API — Threat Intel Provider Keys
# Copy this file to `.env` and fill in your keys. Each key is optional;
# providers without a key are skipped at runtime (see providers.py).

# VirusTotal — https://www.virustotal.com/gui/my-apikey
# Free tier: 4 lookups/min, 500/day
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
# Free tier: 1,000 checks/day
ABUSEIPDB_API_KEY=

# Shodan — https://account.shodan.io/
# Free tier: 1 query/sec, limited endpoints
SHODAN_API_KEY=

# GreyNoise — https://viz.greynoise.io/account/
# Community tier: 10,000 lookups/week
GREYNOISE_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
# Free, no hard rate limit
OTX_API_KEY=

# URLScan.io — https://urlscan.io/user/profile/
# Free tier: 100 public scans/month
URLSCAN_API_KEY=

# Pulsedive — https://pulsedive.com/api/
# Free tier: 30 lookups/min
# NOTE: provider class not implemented in providers.py yet — listed in
# DFIR-PLATFORM-PLAN.md §3.1. Add the key once the integration lands.
PULSEDIVE_API_KEY=
